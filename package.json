{
  "name": "market-monitor",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun src/index.ts",
    "build": "bunx tsc --noEmit",
    "start": "bun src/index.ts",
    "test": "bunx vitest run",
