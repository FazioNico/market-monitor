    "typescript": "^5",
    "vitest": "latest"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "dotenv": "^17.3.1",
    "fast-xml-parser": "latest",
    "gray-matter": "latest",
    "node-cron": "^4.2.1",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  }
}
